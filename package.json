{
  "name": "crosswalk",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "setup": "npm install && prisma generate && prisma migrate deploy && tsx prisma/seed.ts && tsx prisma/seed-enterprise.ts",
    "mac:setup": "bash scripts/mac/setup.sh",
    "mac:start": "bash scripts/mac/start.sh",
    "mac:reset": "bash scripts/mac/reset.sh",
    "mac:doctor": "bash scripts/mac/doctor.sh",
    "mac:stop": "bash scripts/mac/stop.sh",
    "postinstall": "prisma generate",
    "check": "tsx scripts/check.ts",
    "eval": "tsx scripts/eval.ts",
    "check:enterprise": "tsx scripts/check-enterprise.ts",
    "test:enterprise": "tsx scripts/test-enterprise.ts",
    "test:adversarial": "tsx scripts/test-adversarial.ts",
    "profile:run": "tsx scripts/profile-run.ts",
    "db:seed:enterprise": "tsx prisma/seed-enterprise.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:migrate:http": "tsx scripts/migrate-http.ts",
    "worker": "tsx scripts/worker.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "catalog:hygiene": "tsx scripts/catalog-hygiene.ts",
    "embed": "tsx scripts/embed.ts",
    "eval:model": "tsx scripts/model-eval.ts",
    "eval:gate": "tsx scripts/model-eval.ts --gate",
    "test": "vitest run",
    "test:watch": "vitest",
    "secrets:check": "tsx scripts/with-secrets.ts --check",
    "db:preflight": "tsx scripts/db-preflight.ts",
    "retention": "tsx scripts/retention.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "google-auth-library": "^11.0.2",
    "jose": "^6.2.12",
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "openai": "^7.15.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.0",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "^8.21.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.9 <25"
  }
}

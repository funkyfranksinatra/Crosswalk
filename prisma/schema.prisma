// Crosswalk — Competitor Product Cross Reference Engine
// PostgreSQL (Neon) via Prisma 7 driver adapters: @prisma/adapter-pg (TCP) or
// @prisma/adapter-neon (HTTP, for sandboxes without outbound TCP). See src/lib/db.ts.
// Money is Decimal(18,4) with an explicit currency column beside it — see src/lib/money.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// The company Crosswalk is deployed at (one row in v1, but modelled so a
/// multi-tenant deployment is a data change, not a schema change).
model Company {
  id        String       @id @default(cuid())
  name      String       @unique
  /// openFDA labeler names that count as "us" (JSON string[])
  labelers  String       @default("[]")
  createdAt DateTime     @default(now())
  products  OwnProduct[]
  requests  Request[]
}

/// A product the deployed company sells. Seeded from the curated
/// Endomechanical sheet (313 SKUs), enriched from openFDA/GUDID, priced
/// from an optional pricing import.
model OwnProduct {
  id             String           @id @default(cuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id])
  sku            String
  description    String
  category       String? // Class of Trade / product family, e.g. "Trocar Products"
  brand          String?
  labeler        String? // openFDA company_name
  status         String? // commercial_distribution_status
  gudidDi        String?
  gmdnName       String?
  gmdnCode       String?
  fdaProductCode String?
  gudidJson      String? // raw openFDA record (JSON)
  gudidSyncedAt  DateTime?
  /// Structured attribute bin (JSON, see src/lib/match/bin.ts)
  binJson        String?
  binSource      String? // "llm" | "heuristic"
  binnedAt       DateTime?
  /// Money — all optional; the ranker renormalises weights when missing.
  listPrice      Decimal?         @db.Decimal(18, 4)
  cogs           Decimal?         @db.Decimal(18, 4) // legacy global standard cost; StandardCost rows take precedence
  currency       String           @default("USD")
  isActive       Boolean          @default(true)
  /// "seed" (curated sheets) | "manual" (Add SKUs) | "gudid-import" (Catalog → GUDID library)
  source         String           @default("seed")
  /// ---- embedding retrieval (Tier 3) — pgvector column, written/read with raw SQL (src/lib/match/embeddings.ts)
  embedding      Unsupported("vector(1536)")?
  embeddingHash  String? // sha256 of the embedded text: unchanged text is not re-embedded
  embeddingModel String?
  embeddedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  prices         PriceEntry[]
  candidates     MatchCandidate[]
  costs          StandardCost[]
  proposalLines  ProposalLine[]
  purchases      PurchaseRecord[]

  @@unique([companyId, sku])
  @@index([category])
}

/// A competitor product resolved from a CFN, cached across requests.
model CompetitorProduct {
  id             String        @id @default(cuid())
  cfnNorm        String        @unique // normalised catalog number
  cfnMatched     String? // the variant that actually hit (may differ from cfnNorm)
  manufacturer   String?
  labeler        String? // raw openFDA company_name
  brand          String?
  description    String?
  category       String?
  gudidDi        String?
  gmdnName       String?
  gmdnCode       String?
  fdaProductCode String?
  status         String?
  gudidJson      String?
  /// "openfda" | "openfda-variant" | "llm" | "known-cross" | "manual" | "not-found"
  resolution     String
  resolutionNote String?
  confidence     Float? // 0..1; < 0.75 is shown as "verify"
  alternatesJson String? // other openFDA hits for the same CFN (reprocessors etc.)
  binJson        String?
  binSource      String?
  binnedAt       DateTime?
  resolvedAt     DateTime      @default(now())
  /// When the GUDID record behind this row was last re-checked against openFDA (cache TTL, Tier 1)
  gudidCheckedAt DateTime?
  embedding      Unsupported("vector(1536)")?
  embeddingHash  String?
  embeddingModel String?
  embeddedAt     DateTime?
  updatedAt      DateTime      @updatedAt
  lines          RequestLine[]

  @@index([gudidCheckedAt])
}

/// Sizes a rep knows for competitor codes that GUDID does not size (Ethicon meshes, many reloads).
/// Imported from a sheet; applied to the competitor bin ahead of GUDID and regex sizes.
model CompetitorSpec {
  id           String   @id @default(cuid())
  cfnNorm      String   @unique
  manufacturer String?
  description  String?
  dimsJson     String // Dimension[] as in the bin schema
  notes        String?
  source       String   @default("import")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Human-curated cross reference (ground truth). Seeded from Endomechanical.xlsx.
model KnownCross {
  id                    String    @id @default(cuid())
  ownSku                String
  ownDescription        String?
  category              String?
  competitorName        String
  competitorCode        String
  competitorCodeNorm    String
  competitorDescription String?
  matchType             String // Exact Match | Close Match | Alternative Match | US Downsell Match
  preferredOwnSku       String? // reviewer's preferred cross when it differs from ownSku
  additionalProducts    String? // e.g. handle/shell needed
  notes                 String?
  source                String // sheet name | rep | import | proposal
  isActive              Boolean   @default(true)
  // ---- governance (Phase 7) ----
  approvalStatus        String    @default("APPROVED") // DRAFT | IN_REVIEW | APPROVED | REJECTED | RETIRED
  clinicalReviewStatus  String    @default("NOT_REQUIRED") // NOT_REQUIRED | PENDING | APPROVED | REJECTED
  marketingReviewStatus String    @default("NOT_REQUIRED")
  equivalenceLevel      String    @default("FUNCTIONAL") // EXACT | FUNCTIONAL | CLOSEST_ALTERNATIVE | PREMIUM_ALTERNATIVE | PARTIAL_SUBSTITUTE | NONE
  approvedUsage         String?
  justification         String?
  evidenceJson          String?
  reviewerUserId        String?
  approvedByUserId      String?
  approvedAt            DateTime?
  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  version               Int       @default(1)
  accountId             String? // rep-sourced crosses can be account-specific
  createdByUserId       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@unique([ownSku, competitorCodeNorm, source])
  @@index([competitorCodeNorm])
  @@index([approvalStatus])
}

model Pricebook {
  id        String       @id @default(cuid())
  name      String       @unique
  currency  String       @default("USD")
  createdAt DateTime     @default(now())
  entries   PriceEntry[]
  requests  Request[]
}

/// A price for a SKU in a context. Either a legacy price list (pricebookId) or a contract
/// (contractId). Effective-dated, optionally quantity-banded. src/lib/contracts/resolve.ts
/// walks List → GPO → IDN → LOCAL and explains which entry applied.
model PriceEntry {
  id             String     @id @default(cuid())
  pricebookId    String?
  pricebook      Pricebook? @relation(fields: [pricebookId], references: [id], onDelete: Cascade)
  contractId     String?
  contract       Contract?  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  accountId      String?
  account        Account?   @relation(fields: [accountId], references: [id])
  gpoId          String?
  gpo            Gpo?       @relation(fields: [gpoId], references: [id])
  productId      String
  product        OwnProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  productFamily  String?
  price          Decimal    @db.Decimal(18, 4)
  currency       String     @default("USD")
  effectiveFrom  DateTime   @default(now())
  effectiveTo    DateTime?
  tier           String?
  minQty         Decimal?   @db.Decimal(18, 4)
  maxQty         Decimal?   @db.Decimal(18, 4)
  volumeTierName String?
  source         String     @default("import") // import | erp | manual | proposal | backfill
  status         String     @default("ACTIVE") // ACTIVE | PENDING | EXPIRED | SUPERSEDED
  approvalState  String     @default("APPROVED") // APPROVED | PENDING | REJECTED
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([productId, effectiveFrom])
  @@index([contractId, productId])
  @@index([pricebookId, productId])
}

/// One sales-rep submission (one intake spreadsheet).
model Request {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  reference      String        @unique // human id, e.g. REQ-0001
  accountNumber  String?
  accountName    String?
  accountType    String? // Sold-To | Ship-To | Group | IDN
  accountId      String?
  account        Account?      @relation(fields: [accountId], references: [id])
  reportType     String        @default("Competitive Cross Reference with Pricebook")
  pricebookId    String?
  pricebook      Pricebook?    @relation(fields: [pricebookId], references: [id])
  sourceFileName String?
  sourceUrl      String? // Google Sheets link when the intake came from one
  xrefSheetUrl   String? // Drive write-back links (when a service account is configured)
  offerSheetUrl  String?
  status         String        @default("draft") // draft | queued | running | complete | failed
  stage          String? // human-readable current stage
  progress       Int           @default(0) // 0..100
  error          String?
  useLlm         Boolean       @default(true)
  optionsJson    String? // ranking weights etc.
  logJson        String        @default("[]")
  createdBy      String?
  createdByUserId String?
  /// ---- job queue (Tier 1) ----
  jobId           String? // pg-boss job id of the current/last run
  attempt         Int           @default(0) // how many times the queue has started this run
  checkpoint      String? // last completed stage: resolve | bin | match | grade — a retry resumes after it
  cancelRequested Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?
  lines          RequestLine[]
  proposals      Proposal[]

  @@index([status])
}

model RequestLine {
  id                  String             @id @default(cuid())
  requestId           String
  request             Request            @relation(fields: [requestId], references: [id], onDelete: Cascade)
  lineNo              Int
  rawCode             String
  cfnNorm             String
  quantity            Float
  estCompetitorPrice  Decimal?           @db.Decimal(18, 4)
  competitorProductId String?
  competitorProduct   CompetitorProduct? @relation(fields: [competitorProductId], references: [id])
  /// pending | resolved | not-found | error
  resolutionStatus    String             @default("pending")
  resolutionNote      String?
  /// pending | matched | no-match | error
  matchStatus         String             @default("pending")
  selectedCandidateId String?
  overrideNote        String?
  /// Note written FOR the customer (carried onto the proposal / quote); overrideNote stays internal.
  customerNote        String?
  /// "verify" when a rep (or a bulk action) flagged the line for a second look; cleared by review.
  flag                String?
  reviewed            Boolean            @default(false)
  candidates          MatchCandidate[]

  @@index([requestId, lineNo])
}

model MatchCandidate {
  id                 String      @id @default(cuid())
  lineId             String
  line               RequestLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  ownProductId       String
  ownProduct         OwnProduct  @relation(fields: [ownProductId], references: [id])
  rank               Int
  matchType          String // Exact Match | Close Match | Alternative Match | No Match
  /// "known-cross" | "attribute" | "llm"
  source             String
  score              Float // 0..1 composite
  scoreBin           Float?
  scorePrice         Float?
  scoreCogs          Float?
  scoreMargin        Float?
  factorsJson        String? // which factors were available + weights used
  rationale          String?
  additionalProducts String?
  unitPrice          Decimal?    @db.Decimal(18, 4)
  extended           Decimal?    @db.Decimal(18, 4)
  isSelected         Boolean     @default(false)
  createdAt          DateTime    @default(now())

  @@index([lineId, rank])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Observability for every model call (FDE habit: you can't tune what you can't see).
model LlmCall {
  id           String   @id @default(cuid())
  purpose      String
  model        String
  ok           Boolean
  durationMs   Int
  inputTokens  Int?
  outputTokens Int?
  error        String?
  subject      String?
  createdAt    DateTime @default(now())
}

/// Cached model grading verdicts keyed by a hash of their exact inputs, so a
/// re-run with unchanged data replays the verdict instead of re-asking the model.
model LlmGrade {
  key       String   @id
  model     String
  lines     Int      @default(1)
  json      String
  createdAt DateTime @default(now())
}

// =============================================================================
// ENTERPRISE — Phase 1: identity, accounts/GPO, contracts, effective-dated prices,
// cost by context, currency, audit.  (docs/ENTERPRISE_ARCHITECTURE.md §2)
// =============================================================================

/// A person who can act in the platform. SSO populates it; the dev sign-in picks one.
model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  isActive     Boolean       @default(true)
  externalId   String? // SSO subject / CRM user id
  territory    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  roles        UserRole[]
  gudidImports GudidImport[]
  notifications Notification[]
  notificationPreferences NotificationPreference[]
  delegationsGiven    ApprovalDelegation[] @relation("DelegationFrom")
  delegationsReceived ApprovalDelegation[] @relation("DelegationTo")
}

/// Roles are the unit of authorization (permissions matrix in src/lib/auth/permissions.ts).
/// Discount *authority* per role lives in PricingPolicy.authorityJson, not here.
model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   String // SALES_REP | REGIONAL_MANAGER | CONTRACTING_MANAGER | PRICING_ANALYST | PRICING_DIRECTOR | PRICING_COMMITTEE | PRODUCT_MARKETING | CLINICAL_REVIEWER | FINANCE | ADMIN | EXECUTIVE

  @@id([userId, role])
}

/// Customer account. CRM is the system of record; we keep what pricing needs.
model Account {
  id              String                       @id @default(cuid())
  name            String
  accountNumber   String?                      @unique
  type            String                       @default("SOLD_TO") // SOLD_TO | SHIP_TO | IDN | HEALTH_SYSTEM | GROUP
  parentAccountId String?
  parent          Account?                     @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  children        Account[]                    @relation("AccountHierarchy")
  territory       String?
  segment         String?
  region          String?
  country         String                       @default("US")
  currency        String                       @default("USD")
  isStrategic     Boolean                      @default(false)
  ownerUserId     String?
  externalCrmId   String?                      @unique
  taxExempt       Boolean                      @default(false)
  taxExemptionNo  String?
  shipToJson      String? // default ship-to address for tax calculation
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  memberships     GpoMembership[]
  contracts       Contract[]                   @relation("ContractAccount")
  parentContracts Contract[]                   @relation("ContractParentAccount")
  opportunities   Opportunity[]
  requests        Request[]
  priceEntries    PriceEntry[]
  observations    CompetitorPriceObservation[]
  proposals       Proposal[]
  purchases       PurchaseRecord[]

  @@index([parentAccountId])
  @@index([name])
}

model Gpo {
  id           String                       @id @default(cuid())
  name         String                       @unique
  code         String?                      @unique
  createdAt    DateTime                     @default(now())
  memberships  GpoMembership[]
  contracts    Contract[]
  priceEntries PriceEntry[]
  observations CompetitorPriceObservation[]
}

/// Effective-dated membership. Changing it never rewrites historical quotes (proposals snapshot the GPO).
model GpoMembership {
  id            String    @id @default(cuid())
  accountId     String
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  gpoId         String
  gpo           Gpo       @relation(fields: [gpoId], references: [id])
  tier          String?
  effectiveFrom DateTime
  effectiveTo   DateTime?
  source        String    @default("manual") // manual | crm | gpo-feed | import
  verifiedAt    DateTime?
  verifiedBy    String?
  createdAt     DateTime  @default(now())

  @@index([accountId, gpoId])
}

model Opportunity {
  id            String     @id @default(cuid())
  accountId     String
  account       Account    @relation(fields: [accountId], references: [id])
  name          String
  stage         String     @default("Prospecting")
  ownerUserId   String?
  closeDate     DateTime?
  amount        Decimal?   @db.Decimal(18, 4)
  currency      String     @default("USD")
  externalCrmId String?    @unique
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  proposals     Proposal[]
}

/// Contracts are the price *context*. Types form the waterfall: LIST → GPO → IDN → LOCAL.
model Contract {
  id                  String               @id @default(cuid())
  contractNumber      String               @unique
  name                String
  type                String // LIST | GPO | IDN | LOCAL | NATIONAL
  status              String               @default("DRAFT") // DRAFT | ACTIVE | EXPIRED | TERMINATED | SUPERSEDED
  accountId           String?
  account             Account?             @relation("ContractAccount", fields: [accountId], references: [id])
  parentAccountId     String?
  parentAccount       Account?             @relation("ContractParentAccount", fields: [parentAccountId], references: [id])
  gpoId               String?
  gpo                 Gpo?                 @relation(fields: [gpoId], references: [id])
  tier                String?
  currency            String               @default("USD")
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  /// Explicit override of the natural precedence (higher wins). 0 = natural order.
  precedence          Int                  @default(0)
  committedVolume     Decimal?             @db.Decimal(18, 4)
  committedValue      Decimal?             @db.Decimal(18, 4)
  /// Structured clauses validated by zod (src/lib/contracts/clauses.ts)
  renewalJson         String?
  priceProtectionJson String?
  escalationJson      String?
  notes               String?
  sourceSystem        String               @default("crosswalk") // crosswalk | crm | erp | import
  externalId          String?
  ownerUserId         String?
  performanceJson     String? // cached compliance snapshot (src/lib/compliance)
  createdByUserId     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  scopes              ContractScope[]
  entries             PriceEntry[]
  commitments         ContractCommitment[]
  rebates             RebateSchedule[]
  bundles             BundleTerm[]
  proposals           Proposal[]
  purchases           PurchaseRecord[]

  @@index([accountId, status])
  @@index([gpoId, status])
  @@index([type, status])
}

/// Applicability. No rows = whole catalog.
model ContractScope {
  id            String   @id @default(cuid())
  contractId    String
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  productFamily String?
  productId     String?

  @@index([contractId])
}

/// Volume commitment inside a contract (units and/or value, per family or SKU, per period).
model ContractCommitment {
  id             String   @id @default(cuid())
  contractId     String
  contract       Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  productFamily  String?
  productId      String?
  committedUnits Decimal? @db.Decimal(18, 4)
  committedValue Decimal? @db.Decimal(18, 4)
  periodStart    DateTime
  periodEnd      DateTime

  @@index([contractId])
}

/// Rebate schedule: invoice price stays; effective net price is computed (src/lib/contracts/rebates.ts).
model RebateSchedule {
  id            String   @id @default(cuid())
  contractId    String
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  type          String // VOLUME | GROWTH | COMPLIANCE | FAMILY | BUNDLE
  basis         String // UNITS | VALUE | COMPLIANCE_PCT | GROWTH_PCT
  productFamily String?
  tiersJson     String // [{ threshold, rebatePct?, rebateAmount? }]
  periodMonths  Int      @default(12)
  notes         String?

  @@index([contractId])
}

/// Cross-SKU / cross-family terms ("stapler price contingent on trocar volume").
model BundleTerm {
  id            String   @id @default(cuid())
  contractId    String
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  conditionJson String // { productFamily?, productId?, minUnits?, minValue?, awarded? }
  benefitJson   String // { productFamily?, productId?, pricePct?, priceAmount?, rebatePct? }

  @@index([contractId])
}

/// Standard cost by operational context. Most specific effective row wins (plant > region > global).
model StandardCost {
  id            String     @id @default(cuid())
  productId     String
  product       OwnProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  plant         String?
  region        String?
  currency      String     @default("USD")
  costType      String     @default("STANDARD") // STANDARD | LANDED | TRANSFER
  cost          Decimal    @db.Decimal(18, 4)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  source        String     @default("import") // import | erp | manual | backfill
  createdAt     DateTime   @default(now())

  @@index([productId, effectiveFrom])
}

/// Explicit FX. Nothing converts silently; conversions record the rate id they used.
model ExchangeRate {
  id           String   @id @default(cuid())
  fromCurrency String
  toCurrency   String
  rate         Decimal  @db.Decimal(18, 8)
  asOf         DateTime
  source       String   @default("manual")
  createdAt    DateTime @default(now())

  @@unique([fromCurrency, toCurrency, asOf, source])
}

/// Every commercially significant change. Reconstructable history (src/lib/audit.ts).
model AuditEvent {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  beforeJson  String?
  afterJson   String?
  reason      String?
  contextJson String?

  @@index([entityType, entityId, at])
  @@index([actorUserId, at])
}

// =============================================================================
// ENTERPRISE — Phase 2: competitive price intelligence (append-only evidence)
// =============================================================================

model Competitor {
  id           String                       @id @default(cuid())
  name         String                       @unique
  aliasesJson  String                       @default("[]")
  createdAt    DateTime                     @default(now())
  observations CompetitorPriceObservation[]
  outcomes     DealOutcome[]
}

/// Uploaded evidence (invoice, PO, bid file, contract). Extracted values keep a link here.
model Document {
  id                   String                       @id @default(cuid())
  kind                 String // INVOICE | PO | BID_FILE | CONTRACT | COMPETITOR_LIST | OTHER
  filename             String
  mimeType             String?
  storagePath          String?
  uploadedByUserId     String?
  uploadedAt           DateTime                     @default(now())
  extractedJson        String?
  extractionConfidence Float? // 0..1 — extraction quality, NOT commercial confidence
  notes                String?
  observations         CompetitorPriceObservation[]
  purchases            PurchaseRecord[]
}

/// One dated sighting of a competitor price. Never updated except verification fields.
model CompetitorPriceObservation {
  id                  String     @id @default(cuid())
  competitorId        String
  competitor          Competitor @relation(fields: [competitorId], references: [id])
  competitorSku       String
  competitorProductId String?
  price               Decimal    @db.Decimal(18, 4)
  currency            String     @default("USD")
  uom                 String     @default("EA")
  accountId           String?
  account             Account?   @relation(fields: [accountId], references: [id])
  gpoId               String?
  gpo                 Gpo?       @relation(fields: [gpoId], references: [id])
  region              String?
  observedAt          DateTime
  effectiveAt         DateTime?
  /// CUSTOMER_INVOICE | CUSTOMER_PO | CUSTOMER_BID_FILE | GPO_CONTRACT_FILE | WIN_LOSS_RECORD | INTERNAL_VERIFIED | REP_OBSERVED | ANECDOTAL
  sourceType          String
  sourceRef           String?
  documentId          String?
  document            Document?  @relation(fields: [documentId], references: [id])
  enteredByUserId     String?
  rawConfidence       Float // 0..1 as entered / derived from source type
  verificationStatus  String     @default("UNVERIFIED") // UNVERIFIED | VERIFIED | DISPUTED
  verifiedByUserId    String?
  verifiedAt          DateTime?
  notes               String?
  proposalLineId      String?
  createdAt           DateTime   @default(now())

  @@index([competitorSku, observedAt])
  @@index([competitorId, competitorSku])
  @@index([accountId])
}

// =============================================================================
// ENTERPRISE — Phase 3: versioned pricing policy by product family
// =============================================================================

model PricingPolicy {
  id                   String    @id @default(cuid())
  productFamily        String // "*" = default for families without their own policy
  version              Int
  status               String    @default("DRAFT") // DRAFT | ACTIVE | SUPERSEDED
  name                 String?
  targetMarginPct      Decimal   @db.Decimal(7, 4) // 0.4500 = 45%
  minMarginPct         Decimal   @db.Decimal(7, 4)
  floorMethod          String    @default("COST_PLUS_MIN_MARGIN") // COST_PLUS_MIN_MARGIN | PCT_OF_LIST | FIXED
  floorParamsJson      String    @default("{}")
  defaultStrategy      String    @default("MATCH") // MATCH | UNDERCUT_AMOUNT | UNDERCUT_PCT | HOLD_PREMIUM | PRESERVE_CONTRACT | STRATEGIC_DISCOUNT | PENETRATION
  defaultAdjustmentPct Decimal   @default(0) @db.Decimal(7, 4)
  classification       String    @default("DIFFERENTIATED") // COMMODITY | DIFFERENTIATED
  strategicImportance  Int       @default(3) // 1..5
  /// { "SALES_REP": 0.15, "REGIONAL_MANAGER": 0.25, "PRICING_DIRECTOR": 0.40 } — max discount from list
  authorityJson        String
  /// [{ when: { belowFloor?: true, dealValueOver?: n, strategicAccount?: true, contractMonthsOver?: n, marginBelow?: pct }, require: ROLE }]
  approvalRulesJson    String    @default("[]")
  effectiveFrom        DateTime  @default(now())
  supersededAt         DateTime?
  createdByUserId      String?
  createdAt            DateTime  @default(now())

  @@unique([productFamily, version])
  @@index([productFamily, status])
}

// =============================================================================
// ENTERPRISE — Phase 4/5: proposals (versioned snapshots), scenarios, approvals
// =============================================================================

model Proposal {
  id                 String            @id @default(cuid())
  reference          String            @unique // PRP-0001
  version            Int               @default(1)
  parentProposalId   String?
  requestId          String?
  request            Request?          @relation(fields: [requestId], references: [id])
  accountId          String
  account            Account           @relation(fields: [accountId], references: [id])
  opportunityId      String?
  opportunity        Opportunity?      @relation(fields: [opportunityId], references: [id])
  gpoIdSnapshot      String?
  gpoNameSnapshot    String?
  contractId         String?
  contract           Contract?         @relation(fields: [contractId], references: [id])
  currency           String            @default("USD")
  status             String            @default("DRAFT") // DRAFT | APPROVAL_REQUIRED | SUBMITTED | PARTIALLY_APPROVED | APPROVED | REJECTED | CHANGES_REQUESTED | EXPIRED | WON | LOST
  validThrough       DateTime?
  ownerUserId        String?
  policyVersionsJson String            @default("{}") // { family: policyId }
  crosswalkVersionId String?
  crosswalkVersion   CrosswalkVersion? @relation(fields: [crosswalkVersionId], references: [id])
  economicsJson      String? // last computed rollup (src/lib/proposals/economics.ts)
  objectivesJson     String? // user-entered strategic objectives
  /// ---- tax & freight (Tier 3) — quote-level, never part of margin
  freightMode        String            @default("NONE") // NONE | FLAT | PCT
  freightValue       Decimal?          @db.Decimal(18, 4) // flat amount, or percent of subtotal (0..100) when PCT
  freightAmount      Decimal?          @db.Decimal(18, 4) // computed
  taxMode            String            @default("NONE") // NONE | EXEMPT | MANUAL | PROVIDER
  taxRate            Decimal?          @db.Decimal(12, 6) // MANUAL: fraction (0.0825)
  taxAmount          Decimal?          @db.Decimal(18, 4)
  taxProvider        String? // avatax | manual
  taxCalculatedAt    DateTime?
  taxDetailJson      String? // provider breakdown per line / jurisdiction
  taxExemptionNo     String?
  shipToJson         String? // { line1, line2, city, region, postalCode, country }
  lockedAt           DateTime?
  submittedAt        DateTime?
  decidedAt          DateTime?
  createdByUserId    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  lines              ProposalLine[]
  scenarios          Scenario[]
  approvals          ApprovalRequest[]
  outcome            DealOutcome?
  purchases          PurchaseRecord[]

  @@index([accountId, status])
}

/// Everything a line depended on is copied here. A quote never re-reads live tables.
model ProposalLine {
  id                        String            @id @default(cuid())
  proposalId                String
  proposal                  Proposal          @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  lineNo                    Int
  included                  Boolean           @default(true)
  competitorCode            String
  competitorDescription     String?
  competitorName            String?
  competitorProductId       String?
  competitorId              String?
  crossId                   String? // KnownCross id used
  crosswalkVersionId        String?
  equivalenceLevel          String? // EXACT | FUNCTIONAL | CLOSEST_ALTERNATIVE | PREMIUM_ALTERNATIVE | PARTIAL_SUBSTITUTE | NONE
  matchType                 String? // cross-reference verdict as shown to the rep
  productId                 String?
  product                   OwnProduct?       @relation(fields: [productId], references: [id])
  sku                       String?
  description               String?
  productFamily             String?
  quantity                  Decimal           @db.Decimal(18, 4)
  uom                       String            @default("EA")
  listPrice                 Decimal?          @db.Decimal(18, 4)
  contractPrice             Decimal?          @db.Decimal(18, 4)
  contractPriceSource       String? // LIST | GPO | IDN | LOCAL
  waterfallJson             String?
  competitorPrice           Decimal?          @db.Decimal(18, 4)
  competitorPriceConfidence Float?
  competitorPriceBasis      String? // KNOWN_ACCOUNT | MARKET_ESTIMATE | WEAK | NONE
  competitorIntelJson       String?
  cost                      Decimal?          @db.Decimal(18, 4)
  costBasisJson             String?
  floorPrice                Decimal?          @db.Decimal(18, 4)
  targetPrice               Decimal?          @db.Decimal(18, 4)
  ceilingPrice              Decimal?          @db.Decimal(18, 4)
  recommendedPrice          Decimal?          @db.Decimal(18, 4)
  recommendationJson        String?
  policyId                  String?
  proposedPrice             Decimal?          @db.Decimal(18, 4)
  marginAmount              Decimal?          @db.Decimal(18, 4)
  marginPct                 Decimal?          @db.Decimal(12, 6)
  discountFromListPct       Decimal?          @db.Decimal(12, 6)
  discountFromContractPct   Decimal?          @db.Decimal(12, 6)
  requiredAuthority         String? // role
  approvalState             String            @default("NOT_REQUIRED") // NOT_REQUIRED | REQUIRED | PENDING | APPROVED | REJECTED
  justification             String? // premium / clinical justification (internal)
  notes                     String? // internal working notes
  customerNote              String? // printed on the quote / contract offer
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  scenarioLines             ScenarioLine[]
  approvals                 ApprovalRequest[]
  decisions                 MatchDecision[]

  @@index([proposalId, lineNo])
}

/// What-if. Never touches ProposalLine.proposedPrice until explicitly applied.
model Scenario {
  id              String         @id @default(cuid())
  proposalId      String
  proposal        Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  name            String
  kind            String         @default("CUSTOM") // RECOMMENDED | AGGRESSIVE | MARGIN_OPTIMIZED | CUSTOMER_REQUESTED | CUSTOM | FINAL
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  lines           ScenarioLine[]

  @@index([proposalId])
}

model ScenarioLine {
  scenarioId     String
  scenario       Scenario     @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  proposalLineId String
  proposalLine   ProposalLine @relation(fields: [proposalLineId], references: [id], onDelete: Cascade)
  proposedPrice  Decimal?     @db.Decimal(18, 4)
  included       Boolean      @default(true)

  @@id([scenarioId, proposalLineId])
}

model ApprovalRequest {
  id                String        @id @default(cuid())
  proposalId        String
  proposal          Proposal      @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalLineId    String?
  proposalLine      ProposalLine? @relation(fields: [proposalLineId], references: [id], onDelete: Cascade)
  requiredRole      String
  reason            String
  notes             String?
  requestedByUserId String?
  requestedAt       DateTime      @default(now())
  status            String        @default("PENDING") // PENDING | APPROVED | REJECTED | CHANGES_REQUESTED | WITHDRAWN | EXPIRED
  decidedByUserId   String?
  onBehalfOfUserId  String? // set when a delegate decided with someone else's authority (ApprovalDelegation)
  decidedAt         DateTime?
  decisionComments  String?
  snapshotJson      String? // price, recommendation, floor, margin, policy version at request time
  policyId          String?

  @@index([proposalId, status])
  @@index([status, requiredRole])
}

// =============================================================================
// ENTERPRISE — Phase 7: crosswalk governance (published, frozen versions)
// =============================================================================

model CrosswalkVersion {
  id                String                  @id @default(cuid())
  number            Int                     @unique
  status            String                  @default("DRAFT") // DRAFT | IN_REVIEW | PUBLISHED | SUPERSEDED | RETIRED
  notes             String?
  createdByUserId   String?
  createdAt         DateTime                @default(now())
  publishedAt       DateTime?
  publishedByUserId String?
  supersededAt      DateTime?
  entries           CrosswalkVersionEntry[]
  proposals         Proposal[]
}

/// Frozen copy of an approved cross at publish time. Historical proposals point here.
model CrosswalkVersionEntry {
  id                 String           @id @default(cuid())
  versionId          String
  version            CrosswalkVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  knownCrossId       String
  ownSku             String
  competitorName     String
  competitorCodeNorm String
  matchType          String
  equivalenceLevel   String
  approvedUsage      String?
  additionalProducts String?

  @@index([versionId, competitorCodeNorm])
}

// =============================================================================
// ENTERPRISE — Phase 8: integration boundaries
// =============================================================================

model ExternalRef {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  system     String // salesforce | sap | gpo-feed | dev
  externalId String
  syncedAt   DateTime @default(now())
  syncHash   String?

  @@unique([system, entityType, externalId])
  @@index([entityType, entityId])
}

model SyncLog {
  id          String   @id @default(cuid())
  system      String
  direction   String // IN | OUT
  entityType  String
  entityId    String?
  externalId  String?
  status      String // OK | RETRY | FAILED | SKIPPED
  attempt     Int      @default(1)
  error       String?
  payloadHash String?
  at          DateTime @default(now())

  @@index([system, at])
}

// =============================================================================
// ENTERPRISE — Phase 9/10: compliance + analytics facts
// =============================================================================

/// Actual purchases (ERP order feed or import). Compliance is computed from these.
model PurchaseRecord {
  id          String      @id @default(cuid())
  accountId   String
  account     Account     @relation(fields: [accountId], references: [id])
  productId   String?
  product     OwnProduct? @relation(fields: [productId], references: [id])
  sku         String
  quantity    Decimal     @db.Decimal(18, 4)
  netPrice    Decimal     @db.Decimal(18, 4)
  currency    String      @default("USD")
  invoiceDate DateTime
  contractId  String?
  contract    Contract?   @relation(fields: [contractId], references: [id])
  proposalId  String?
  proposal    Proposal?   @relation(fields: [proposalId], references: [id])
  source      String      @default("import") // import | erp
  externalId  String?
  documentId  String?
  document    Document?   @relation(fields: [documentId], references: [id])
  createdAt   DateTime    @default(now())

  @@index([accountId, invoiceDate])
  @@index([accountId, externalId])
  @@index([contractId])
}

model DealOutcome {
  id               String      @id @default(cuid())
  proposalId       String      @unique
  proposal         Proposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  outcome          String // WON | LOST | NO_DECISION
  competitorId     String?
  competitor       Competitor? @relation(fields: [competitorId], references: [id])
  priceReason      String?
  commercialReason String?
  finalValue       Decimal?    @db.Decimal(18, 4)
  currency         String      @default("USD")
  decidedAt        DateTime    @default(now())
  recordedByUserId String?
  notes            String?
}

/// Every cross-reference choice a person made. "Rep acceptance" and "validated accuracy" are different columns.
model MatchDecision {
  id                String        @id @default(cuid())
  requestLineId     String?
  proposalLineId    String?
  proposalLine      ProposalLine? @relation(fields: [proposalLineId], references: [id])
  topRecommendedSku String?
  chosenSku         String?
  acceptedTop       Boolean
  overrideReason    String?
  productFamily     String?
  competitorName    String?
  confidence        Float?
  decidedByUserId   String?
  at                DateTime      @default(now())
  groundTruth       String        @default("UNKNOWN") // VALIDATED_CORRECT | VALIDATED_INCORRECT | UNKNOWN

  @@index([productFamily, at])
}

/// ---- GUDID library (Catalog → GUDID library) -------------------------------------
/// A labeler's whole GUDID catalog pulled from openFDA in bulk so the resolver can answer
/// from the database first (no network per code) and people can look products up.
/// Keyed by openFDA's public_device_record_key: a catalog number is NOT unique across
/// labelers, so cfnNorm is only indexed and the resolver ranks colliding hits exactly
/// as it ranks live openFDA hits.
model GudidDevice {
  id             String       @id @default(cuid())
  recordKey      String       @unique
  primaryDi      String?
  labeler        String // raw company_name
  manufacturer   String // displayManufacturer(labeler)
  catalogNumber  String?
  versionModel   String?
  cfnNorm        String? // normalised catalogNumber ?? versionModel (what a rep types)
  cfnCompact     String? // cfnNorm without punctuation
  brand          String?
  description    String?
  gmdnName       String?
  gmdnCode       String?
  fdaProductCode String?
  status         String?
  family         String? // heuristic bin family, for the library filter
  sizesJson      String?
  singleUse      Boolean?
  sterile        Boolean?
  implantable    Boolean?
  gudidJson      String
  publishDate    String?
  versionDate    String?
  importId       String?
  import         GudidImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  importedAt     DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([cfnNorm])
  @@index([cfnCompact])
  @@index([primaryDi])
  @@index([manufacturer])
  @@index([brand])
}

/// One bulk import run (a labeler query against openFDA). Progress is persisted so it
/// survives a page reload; the runner is in-process (see PRODUCTION_READINESS §3.1).
model GudidImport {
  id                 String        @id @default(cuid())
  query              String // openFDA company_name phrase, e.g. "Ethicon"
  /// "COMPETITOR" | "OWN"
  kind               String
  addToOwnCatalog    Boolean       @default(false)
  familiesJson       String? // Family[] filter for addToOwnCatalog (null = all)
  productCodesJson   String? // FDA product-code filter (null = all)
  inDistributionOnly Boolean       @default(true)
  /// QUEUED | RUNNING | DONE | FAILED | CANCELLED
  status             String        @default("QUEUED")
  expected           Int?
  fetched            Int           @default(0)
  created            Int           @default(0)
  updated            Int           @default(0)
  ownAdded           Int           @default(0)
  errors             Int           @default(0)
  log                String        @default("")
  error              String?
  startedById        String?
  startedBy          User?         @relation(fields: [startedById], references: [id], onDelete: SetNull)
  startedAt          DateTime      @default(now())
  finishedAt         DateTime?
  /// ---- job queue (Tier 1) ----
  jobId              String?
  attempt            Int           @default(0)
  cursorJson         String? // { leaf, skip } — a retry resumes paging here instead of from the start
  cancelRequested    Boolean       @default(false)
  devices            GudidDevice[]
}

// =============================================================================
// TIER 1 — pilot quality: notifications, alerts, feeds, benchmarks, model evals
// =============================================================================

/// One message to one person. In-app rows are the system of record; email / Teams
/// deliveries are attempts recorded in deliveriesJson (channel → { at, ok, error }).
model Notification {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// RUN_COMPLETE | RUN_FAILED | APPROVAL_REQUESTED | APPROVAL_DECIDED | PROPOSAL_APPROVED | CROSS_PROPOSED | FEED_FAILED | ALERT | JOB_FAILED
  kind          String
  title         String
  body          String?
  link          String?
  entityType    String?
  entityId      String?
  readAt        DateTime?
  deliveriesJson String?
  /// Suppresses a repeat of the same message to the same person within an hour (alerts, feed failures, resubmissions)
  dedupeKey     String?
  createdAt     DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([entityType, entityId])
  @@index([userId, dedupeKey, createdAt])
}

/// Per-user, per-kind channel switches. Absent row = defaults (in-app on; email on when SMTP is configured; Teams off).
model NotificationPreference {
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   String // a Notification.kind or "*"
  inApp  Boolean @default(true)
  email  Boolean @default(true)
  teams  Boolean @default(false)

  @@id([userId, kind])
}

/// A monitoring condition that is currently (or was) firing. One row per fingerprint;
/// re-evaluations update lastSeenAt, clear resolvedAt when it fires again.
model Alert {
  id           String    @id @default(cuid())
  fingerprint  String    @unique // e.g. "model_unreachable", "feed_stale:erp-costs", "queue_stalled:request.run"
  rule         String
  severity     String // INFO | WARNING | CRITICAL
  title        String
  detail       String?
  firstFiredAt DateTime  @default(now())
  lastFiredAt  DateTime  @default(now())
  lastNotifiedAt DateTime?
  resolvedAt   DateTime?
  contextJson  String?

  @@index([resolvedAt, severity])
}

/// One scheduled (or manual) ingestion of one feed: erp-costs, erp-skus, erp-purchases,
/// crm-accounts, gpo-memberships, pricing (pricebook), competitor-sizes.
model FeedRun {
  id          String    @id @default(cuid())
  feed        String
  trigger     String // schedule | manual | startup
  status      String    @default("RUNNING") // RUNNING | OK | FAILED | SKIPPED
  sourceRef   String? // file path / API endpoint
  sourceHash  String? // hash of the file (or payload) so an unchanged feed is skipped
  rows        Int       @default(0)
  created     Int       @default(0)
  updated     Int       @default(0)
  skipped     Int       @default(0)
  failed      Int       @default(0)
  error       String?
  reportJson  String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  jobId       String?

  @@index([feed, startedAt])
}

/// One execution of the multi-list accuracy benchmark (scripts/benchmark.ts).
model BenchmarkRun {
  id          String   @id @default(cuid())
  label       String?
  model       String? // null = heuristic only
  promptVersion Int?
  binVersion  Int?
  gitRef      String?
  cases       Int
  lines       Int
  resolved    Int
  top1        Int
  top3        Int
  tierAgree   Int
  byFamilyJson String
  byCaseJson  String
  missesJson  String?
  durationMs  Int
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

/// One measurement of model grading agreement against the curated crosses
/// (scripts/model-eval.ts). The accepted baseline gates prompt / model changes.
model ModelEval {
  id            String   @id @default(cuid())
  model         String
  promptVersion Int
  binVersion    Int
  sampleSeed    Int
  sampleSize    Int
  graded        Int
  top1Agree     Int
  tierAgree     Int
  noMatchFalse  Int // model said No Match where the curated sheet has a cross
  durationMs    Int
  costTokens    Int?
  accepted      Boolean  @default(false)
  notes         String?
  detailJson    String?
  createdAt     DateTime @default(now())

  @@index([model, promptVersion, createdAt])
}

// =============================================================================
// TIER 3 — product and scale
// =============================================================================

/// Out-of-office: `from` lends their approval authority to `to` for a window. The delegate
/// decides in their own name; the request records on whose behalf. Never grants ADMIN.
model ApprovalDelegation {
  id              String    @id @default(cuid())
  fromUserId      String
  from            User      @relation("DelegationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId        String
  to              User      @relation("DelegationTo", fields: [toUserId], references: [id], onDelete: Cascade)
  startsAt        DateTime
  endsAt          DateTime
  reason          String?
  createdByUserId String?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([toUserId, startsAt, endsAt])
  @@index([fromUserId])
}

/// A materialised analytics report: computed by the analytics.refresh job, read by the pages.
model AnalyticsSnapshot {
  id         String   @id @default(cuid())
  report     String
  json       String
  durationMs Int      @default(0)
  computedAt DateTime @default(now())
  trigger    String   @default("schedule") // schedule | event | manual

  @@index([report, computedAt])
}

/// A public-sector award / bid record pulled from SAM.gov, USAspending or a bid-file drop.
model PublicAward {
  id              String    @id @default(cuid())
  source          String // SAM | USASPENDING | BIDFILE
  externalId      String
  title           String?
  agency          String?
  awardee         String?
  awardeeId       String? // UEI / DUNS where the source gives one
  naics           String?
  psc             String?
  amount          Decimal?  @db.Decimal(18, 2)
  currency        String    @default("USD")
  awardDate       DateTime?
  postedDate      DateTime?
  description     String?
  url             String?
  competitorId    String? // matched competitor (by awardee name / alias)
  keywordsMatched String? // which configured keywords / codes hit
  rawJson         String?
  importedAt      DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([source, externalId])
  @@index([awardDate])
  @@index([competitorId])
}

# ---- Crosswalk local configuration ---------------------------------------------
# Copy to .env and fill in what you have. Everything is optional: with no
# OPENAI_API_KEY the app runs in deterministic "heuristic" mode.

# PostgreSQL connection (Neon). Ask the project owner for the shared dev database URL,
# or create a free Neon project and paste its connection string.
DATABASE_URL="postgresql://user:password@host/crosswalk?sslmode=verify-full"
# "pg" (default, TCP), "neon-ws" (WebSocket — HTTPS-only environments such as cloud sandboxes), or "neon-http" (scripts only, no transactions)
DATABASE_ADAPTER="pg"

# LLM. Set the exact model ID you have access to (e.g. your "gpt 5.6 astra" id).
OPENAI_API_KEY=""
LLM_MODEL="gpt-5.6-astra"
# Optional: point at a compatible gateway / Azure endpoint instead of api.openai.com
# OPENAI_BASE_URL="https://api.openai.com/v1"

# openFDA (optional; raises the rate limit from 240 to 1000 requests/min)
OPENFDA_API_KEY=""

# Name shown as "us" throughout the UI and exports
COMPANY_NAME="Medtronic"

# ---- Google Sheets / Drive (all optional) ------------------------------------
# Link-shared sheets ("Anyone with the link") are read with NO credentials.
# A service account adds: reading private sheets shared with it, and writing
# exports into a Drive folder as native Google Sheets. Free; ~10 min setup —
# see Settings → Google Sheets & Drive in the app for the steps.
# Path to the service-account key file, or the JSON itself on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=""
# Drive folder (id or URL) shared with the service-account email as Editor.
GOOGLE_DRIVE_FOLDER_ID=""

# ---- Secrets -------------------------------------------------------------------
# Where secrets come from. "env" (default): this file / the container environment. Anything
# else is fetched once at start-up (web, worker, container entrypoint) and copied into the
# environment; keys already set in the environment win unless SECRETS_OVERRIDE=true.
# SECRETS_PROVIDER="env"           # env | aws | vault | doppler | file
# AWS_SECRET_ID=""                 # aws: Secrets Manager secret holding a JSON object of KEY: value
#                                  #      (needs `npm install @aws-sdk/client-secrets-manager`; AWS_REGION + credential chain)
# VAULT_ADDR="" VAULT_TOKEN="" VAULT_SECRET_PATH="secret/data/crosswalk/prod"   # vault: KV v2 (VAULT_TOKEN_FILE, VAULT_NAMESPACE optional)
# DOPPLER_TOKEN=""                 # doppler: a service token (DOPPLER_PROJECT / DOPPLER_CONFIG when the token is not bound)
# SECRETS_FILE="/run/secrets/crosswalk"   # file: JSON object or KEY=value lines (a mounted secret)
# A production build refuses to start with the development session key, a default database
# password, or placeholder secrets: `npm run secrets:check` runs the same check.

# ---- Retention (docs/BACKUPS.md) ---------------------------------------------------
# Nothing is deleted until RETENTION_ENABLED=true. Windows in days; unset = default once enabled,
# "off" = keep. Customer purchase data (requests) has NO default: set RETENTION_REQUESTS_DAYS only
# after the retention decision in docs/DATA_ACCESS_POLICY.md is signed. Audit events are never swept.
# RETENTION_ENABLED=""             # "true" schedules the nightly sweep (RETENTION_CRON, default 45 2 * * *)
# RETENTION_DRY_RUN=""             # "true": the sweep reports what it would delete and deletes nothing
# RETENTION_REQUESTS_DAYS=""       # finished requests no proposal references (e.g. 365)
# RETENTION_LLM_CALLS_DAYS="90"  RETENTION_SYNC_LOG_DAYS="180"  RETENTION_FEED_RUNS_DAYS="180"
# RETENTION_NOTIFICATIONS_DAYS="180"  RETENTION_SNAPSHOTS_DAYS="90"  RETENTION_ALERTS_DAYS="90"
# RETENTION_BATCH="5000"           # rows per class per sweep
# LLM_SEND_ACCOUNT_NAME=""         # "false" keeps the customer account name out of model prompts

# ---- Request security ----------------------------------------------------------
# Per-client, per-minute API limits (in-process; one window per instance). Sign-in routes,
# expensive routes (uploads, pipeline runs, imports, exports) and everything else.
# RATE_LIMIT_AUTH="20"  RATE_LIMIT_HEAVY="60"  RATE_LIMIT_API="600"  RATE_LIMIT_DISABLED=""
# TRUST_PROXY_HOPS="1"             # which X-Forwarded-For entry is the client (1 = set by the nearest proxy)
# CSP_REPORT_ONLY=""               # "true" sends Content-Security-Policy-Report-Only while rolling out

# ---- Identity ------------------------------------------------------------------
# With no SSO configured the app offers a clearly-labelled development sign-in (seeded users).
# Setting SSO_ISSUER + SSO_CLIENT_ID turns on the built-in OpenID Connect client
# (authorization code + PKCE; Entra ID, Okta, Keycloak, any provider with discovery).
#   Entra ID: SSO_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
#   Okta:     SSO_ISSUER="https://<org>.okta.com" (or the custom authorization server URL)
# Register the redirect URI  <APP_BASE_URL>/api/auth/oidc/callback  with the provider.
SSO_ISSUER=""
SSO_CLIENT_ID=""
# Confidential client secret; leave blank for a public client (PKCE protects the exchange).
SSO_CLIENT_SECRET=""
# SSO_MODE="oidc"                 # oidc (default) | proxy — proxy keeps the older contract where an
#                                 # authenticating reverse proxy sets x-sso-subject on every request
# SSO_REDIRECT_URI=""             # default <APP_BASE_URL>/api/auth/oidc/callback
# SSO_SCOPES="openid profile email"
# Roles from a token claim. Entra app roles arrive in "roles"; Okta groups in "groups" (add the
# groups claim to the app); Keycloak in "realm_access.roles". When the claim is present it is
# authoritative and the user's roles are synced at every sign-in; when absent, roles set in
# Crosswalk stand. Values that are Crosswalk role names map to themselves; anything else via
# SSO_ROLE_MAP (JSON or  idp-name=ROLE,other=ROLE).
# SSO_ROLE_CLAIM="roles"
# SSO_ROLE_MAP="CW-Reps=SALES_REP,CW-Pricing=PRICING_ANALYST,CW-Admins=ADMIN"
# SSO_DEFAULT_ROLE=""             # given to a user whose claim maps to nothing (blank = refuse sign-in)
# SSO_AUTO_PROVISION="true"       # create users on first sign-in ("false": users must be pre-created)
# SESSION_TTL_HOURS="12"          # OIDC session cookie lifetime
# Signs the session cookies (dev and OIDC). Required for a production build; 16+ random characters.
# Without it a `next dev` box uses a fixed insecure key so restarts keep you signed in.
SESSION_SECRET=""
# A production build (next start) refuses the development sign-in unless this is "true" —
# only ever set it on a demo instance that nobody outside the team can reach.
ALLOW_DEV_SIGNIN=""

# ---- Integrations (leave blank to use the labelled development adapters) --------
# Route 1 — file feed (works today): a folder where CRM / ERP / GPO exports land as CSV
# (crm-accounts.csv, crm-opportunities.csv, erp-skus.csv, erp-costs.csv, erp-purchases.csv,
# gpo-memberships.csv — headers in src/lib/integrations/file.ts). Approved quotes are written
# to <dir>/outbound/quotes/. Settings → Integrations shows which files are found.
INTEGRATION_FEED_DIR=""
# Route 2 — vendor APIs. Setting these selects the API adapter; the Salesforce and SAP
# adapters are skeletons that need an implementation against the vendor API first.
# Salesforce CRM
SF_LOGIN_URL=""
SF_CLIENT_ID=""
SF_CLIENT_SECRET=""
SF_API_VERSION="v61.0"
# SAP ERP (OData)
SAP_ODATA_BASE_URL=""
SAP_CLIENT=""
# Push blended margin to CRM quotes? Most organisations keep margin out of CRM.
CRM_PUSH_MARGIN="false"

# ---- Background jobs (Tier 1) ------------------------------------------------------
# Runs, GUDID imports, feed ingestion, deliveries and alert checks run on a pg-boss queue in
# the same database (schema "pgboss"). Workers run inside the Next server by default:
#   inline   (default) the web server processes jobs
#   external the web server only enqueues; run `npm run worker` alongside it
#   off      no queue at all (tests / one-shot scripts)
JOBS_WORKER="inline"
# JOBS_POOL_MAX="3"          # connections the queue keeps for itself
# APP_BASE_URL="http://localhost:3000"   # used in notification links

# ---- openFDA limits and cache expiry ----------------------------------------------
# Request budget per minute (default: 80% of openFDA's limit — 240 without a key, 1000 with).
# OPENFDA_RPM=""
# OPENFDA_MAX_ATTEMPTS="5"    # retries on 429 / 5xx with exponential backoff and Retry-After
# Cached GUDID records older than this are re-checked in the background (nightly + on use).
# GUDID_CACHE_TTL_DAYS="90"
# GUDID_REFRESH_CRON="30 3 * * *"

# ---- Scheduled feeds --------------------------------------------------------------
# Feeds read INTEGRATION_FEED_DIR (crm-*.csv, erp-*.csv, gpo-memberships.csv, pricing.csv,
# competitor-sizes.csv, competitor-prices.csv) on cron (UTC). Override per feed, "off" disables.
# FEED_CRM_CRON="0 2 * * *"           FEED_CRM_MAX_AGE_HOURS="36"
# FEED_ERP_CRON="30 2 * * *"          FEED_ERP_MAX_AGE_HOURS="36"
# FEED_GPO_CRON="0 3 * * 1"           FEED_GPO_MAX_AGE_HOURS="192"
# FEED_PRICING_CRON="15 2 * * *"
# FEED_COMPETITOR_SIZES_CRON="0 4 * * 1"
# FEED_COMPETITOR_PRICES_CRON="45 2 * * *"
# FEEDS_RUN_ON_START="false"          # ingest every feed once when the worker starts

# ---- Notifications ----------------------------------------------------------------
# In-app notifications always work. Email and Teams are delivered by the queue when set.
# SMTP_URL="smtps://user:password@smtp.example.com:465"
# MAIL_FROM="Crosswalk <crosswalk@example.com>"
# TEAMS_WEBHOOK_URL="https://outlook.office.com/webhook/…"   # an incoming webhook on a channel
# NOTIFY_DRY_RUN="false"              # record deliveries without sending (demos, CI)

# ---- Observability ----------------------------------------------------------------
# LOG_FORMAT="json"                   # json (default in production) | pretty
# LOG_LEVEL="info"                    # debug | info | warn | error
# METRICS_TOKEN=""                    # Bearer token for /api/metrics (else ADMIN session only)
# Alert thresholds (checked every ALERTS_CRON):
# ALERTS_CRON="*/5 * * * *"
# ALERT_RESOLUTION_MIN="0.7"          # last run resolved fewer than this share of its codes
# ALERT_RUN_FAILURES="2"              # failed runs per 24 h before alerting
# ALERT_QUEUE_STALL_MIN="15"          # minutes a ready job may wait before "stalled"
# ALERT_RENOTIFY_HOURS="6"            # how often a still-firing alert is re-sent

# ---- Tier 3: retrieval, tax, public bids, analytics ---------------------------------
# Embedding retrieval needs pgvector in the database (the Tier 3 migration enables it) and the
# model key above. `npm run embed` embeds the catalog once; the nightly job keeps it current.
# EMBEDDINGS="on"                     # "off" → attribute scan only
# EMBEDDING_MODEL="text-embedding-3-small"
# EMBEDDING_RETRIEVAL_K="40"          # nearest catalog products per line before attribute scoring
# EMBEDDING_TIMEOUT_MS="20000"
# EMBED_REFRESH_CRON="15 4 * * *"     EMBED_REFRESH_BATCH="5000"   # rows per nightly sweep ("off" disables the cron)
#
# Tax: PROVIDER mode on a proposal calls Avalara AvaTax (uncommitted SalesOrder, never a document).
# Without these, MANUAL rate and EXEMPT still work and quotes can state "excludes tax".
# AVATAX_ACCOUNT_ID=""  AVATAX_LICENSE_KEY=""  AVATAX_COMPANY_CODE=""
# AVATAX_ENV="sandbox"                # sandbox | production (AVATAX_BASE_URL overrides the endpoint)
# AVATAX_ITEM_TAX_CODE="P0000000"     AVATAX_FREIGHT_TAX_CODE="FR020100"
# TAX_TIMEOUT_MS="20000"
# TAX_DRY_RUN="false"                 # true → no call, tax shown as 0 (demos, CI)
# TAX_FREIGHT="false"                 # MANUAL mode: tax the freight line too
#
# Public bid intelligence (Competitor pricing → Public bids). USAspending needs no key;
# SAM.gov needs a personal API key (api.sam.gov; the public key allows a handful of calls a day —
# one request per configured NAICS per pull, SAM_MAX_PAGES pages each; a 429 ends the run without retry).
# SAM_API_KEY=""
# SAM_MAX_PAGES="1"
# BIDS_USASPENDING="on"
# BIDS_CRON="0 5 * * *"               # "off" disables the scheduled pulls
# BIDS_TIMEOUT_MS="45000"             # SAM_API_URL / USASPENDING_API_URL override the endpoints (tests, proxies)
#
# Materialised analytics: recomputed hourly and after outcomes/decisions; older than this is "stale".
# ANALYTICS_CRON="0 * * * *"          # "off" disables the hourly refresh (events and the button still refresh)
# ANALYTICS_STALE_MINUTES="120"

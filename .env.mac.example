# ---- Crosswalk on a Mac (mac-demo branch) -------------------------------------------
# `npm run mac:setup` copies this to .env and fills SESSION_SECRET. Nothing here is a secret
# you need from anyone else: the database is the local Docker/Homebrew Postgres.

# Docker (default, `docker compose up -d`): port 5433. Homebrew Postgres: use 5432 and your own user.
DATABASE_URL="postgresql://crosswalk:crosswalk@localhost:5433/crosswalk"
DATABASE_ADAPTER="pg"

# Development sign-in with the seeded users (no SSO on a laptop). Both are needed by `npm start`;
# `npm run dev` ignores them.
ALLOW_DEV_SIGNIN="true"
SESSION_SECRET="replace-me"

# Optional: a model key makes bins/grading sharper. Without it the app runs in heuristic mode.
OPENAI_API_KEY=""
LLM_MODEL="gpt-5.6-astra"

# Optional: openFDA key raises the request budget (240/min → 1,000/min).
OPENFDA_API_KEY=""

# Background jobs run inside `npm run dev` (JOBS_WORKER=inline). Nothing to configure.
JOBS_WORKER="inline"
NOTIFY_DRY_RUN="true"
TAX_DRY_RUN="true"
COMPANY_NAME="Medtronic"
